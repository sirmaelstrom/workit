{
  "release": {
    "bump": [
      { "file": ".claude-plugin/plugin.json", "jsonPath": "version" },
      { "file": ".claude-plugin/marketplace.json", "jsonPath": "plugins.0.version" }
    ],
    "level": "patch",
    "pr": true,
    "after": ["claude plugin update workit@workit"],
    "verify": ["node --test"]
  },
  "contractPaths": [
    "scripts/lane.mjs",
    "scripts/session.mjs",
    "scripts/run-log.mjs",
    "skills/slim-review/scripts/pr-review.mjs"
  ],
  "laneSuite": "Zero dependencies and a short suite: run the full node --test before the PR boundary; the conductor runs it once more at the candidate head."
}
